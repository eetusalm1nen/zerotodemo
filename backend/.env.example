# Copy to backend/.env for local dev. Never commit .env or token.json.

# 1 = fake data, no Google calls (default). 0 = real Google Calendar + real agent.
MOCK=1
TIMEZONE=Europe/Helsinki
# Optional fixed "current time" for repeatable demos/tests
# DEMO_NOW=2026-11-09T08:00:00+02:00

# Extra exact origins (comma-separated). Lovable domains are already allowed by CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*(lovable\.app|lovable\.dev|lovableproject\.com)

# --- Google Calendar (MOCK=0) ---
GOOGLE_CALENDAR_ID=primary
# Local dev: path to the token written by scripts/google_auth.py
GOOGLE_TOKEN_FILE=token.json
# Render/Railway: paste the whole token.json contents as one line instead
# GOOGLE_TOKEN_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}

# --- Agent (Tom) ---
# ANTHROPIC_API_KEY=
